{
  "name": "personal-command-center",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24.15.0 <25"},
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "node scripts/dev.mjs",
    "pretest": "node scripts/check-node.mjs",
    "test": "node --test --test-concurrency=4 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build --config apps/web/vite.config.ts",
    "prestart": "node scripts/check-node.mjs",
    "start": "node dist/server/apps/server/main.js"
  },
  "dependencies": {"@simplewebauthn/browser":"13.3.0","@simplewebauthn/server":"13.3.3","react":"19.3.0","react-dom":"19.3.0"},
  "devDependencies": {
    "@types/node":"24.19.1","@types/react":"19.3.0","@types/react-dom":"19.3.0",
    "@vitejs/plugin-react":"6.1.2","typescript":"7.0.2","vite":"8.3.2"
  }
}
