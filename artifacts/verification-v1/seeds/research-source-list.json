        "code": "import unittest\nfrom oracle_observations import observations\n\nclass TestOracle(unittest.TestCase):\n    def test_e1(self):\n        cases = [('alpha', 'alpha research', {'https://example.org/a': 'Alpha A', 'https://example.org/b': 'Alpha B'}, 3), ('beta', 'beta research', {'https://example.org/c': 'Beta C'}, 2), ('unknown', None, {}, 1), ('fresh', None, {}, 0)]\n        for ident, topic, expected, setup_count in cases:\n            o = next(x for x in observations if x['id'] == ident)\n            self.assertEqual(o['setupExitCodes'], [0] * setup_count)\n            self.assertEqual(o['exitCode'], 0)\n            self.assertFalse(o.get('jsonParseError'))\n            rows = o['jsonOutput']\n            self.assertIsInstance(rows, list)\n            self.assertEqual(len(rows), len(expected))\n            self.assertEqual({r['url']: r['title'] for r in rows}, expected)\n            for row in rows:\n                self.assertEqual(row['topic'], topic)\n                self.assertTrue(row['source_id'])\n            self.assertEqual(o['beforeFiles'], o['afterFiles'])\n            self.assertEqual([e for e in o['effects'] if e['kind'] in ('network', 'write')], [])\n",
