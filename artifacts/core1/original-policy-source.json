  "nativeBlock": "  if(result.verdict==='ERROR'){if(result.layers[0]?.status==='PASS'&&result.layers[1]?.gaps.some(g=>g.id==='project-recipes'))return {verdict:'NOT CHECKED',gaps:result.gaps.map(g=>g.reason),failures:[],verificationId:request.id,evidenceHash:evidence.hash};throw Error(view.error??result.layers.flatMap(l=>l.gaps.map(g=>g.reason)).join('; ')??'Checker harness error');}\n  return {...(result.testWriter?{testWriter:result.testWriter}:{}),verdict:result.verdict,gaps:result.gaps.map(g=>g.id+': '+g.reason),failures:result.layers.flatMap(l=>l.checks.filter(c=>c.status==='FAIL').map(c=>c.id+': '+(c.reason??'protected assertion failed'))),verificationId:request.id,evidenceHash:evidence.hash};",
